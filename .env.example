# Public site URL used for canonical links, Open Graph tags, sitemap.xml and structured data.
# No trailing slash. Replace with the real production domain before deploying.
VITE_SITE_URL=https://www.localpos.in

# Where the "Login" button in the header should go (your web app).
VITE_LOGIN_URL=https://app.localpos.in/

# Optional: endpoint that receives lead-form submissions (Book a Demo, Contact Us) as JSON via POST.
# When empty, the forms run in preview mode and nothing is sent.
VITE_LEAD_ENDPOINT=
